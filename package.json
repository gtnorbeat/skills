{
  "name": "aura-labels-app",
  "version": "1.0.0",
  "description": "AURA — Cloudflare Workers monorepo",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/db --if-present && npm run typecheck -w apps/auralabels --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy": "npm run deploy -w apps/auralabels --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.62.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
