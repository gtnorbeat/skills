# =============================================================================
# Cloudflare Workers — Environment Variables
# =============================================================================
# Copy to .env and fill in your keys. Never commit real secrets.
#
# LLM calls are routed through a dedicated LLM Worker.
# See apps/llm-worker/.dev.vars.example for LLM-specific secrets.
#
# Database: Neon Postgres
# =============================================================================


# ---------------------------------------------------------------------------
# DATABASE — Neon Postgres (used by internal Worker)
# ---------------------------------------------------------------------------

# Neon Postgres connection string.
# Create a free database at: https://console.neon.tech
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require


# ---------------------------------------------------------------------------
# INTERNAL API — Auth between Workers
# ---------------------------------------------------------------------------

# API key shared between Workers for internal authentication.
# Must match the key set in the internal Worker's secrets.
# INTERNAL_API_KEY=...

# URL of the internal Worker.
# INTERNAL_API_URL=https://aura-nexus-internal.gtnorbeat.workers.dev


# ---------------------------------------------------------------------------
# CLOUDFLARE — API token for wrangler deployment
# ---------------------------------------------------------------------------

# Cloudflare API token with Workers permissions.
# Create a token at: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=...
