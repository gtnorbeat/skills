# =============================================================================
# AURA Nexus — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to git — it is already in .gitignore.
#    Only .env.example should be committed.
#
# Provider: OpenRouter (single API key for all models)
# Database: Neon Postgres
# State/Cloud: Cloudflare Workers (2x — internal + chat)
# =============================================================================


# ---------------------------------------------------------------------------
# REQUIRED — without these the CLI won't start
# ---------------------------------------------------------------------------

# OpenRouter API key — the single key for all LLM calls (planner, executor).
# Models used: gemini-2.5-flash (planner), deepseek/deepseek-v4-flash (agent).
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...


# ---------------------------------------------------------------------------
# DATABASE — Neon Postgres (for persistent state / conversations)
# ---------------------------------------------------------------------------

# Neon Postgres connection string.
# Create a free database at: https://console.neon.tech
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require


# ---------------------------------------------------------------------------
# INTERNAL API — State/DB Backend (Cloudflare Worker)
# ---------------------------------------------------------------------------

# URL of the internal aura-nexus Worker for persistent state, conversations,
# memory, and file storage. Required for cloud-synced CLI state.
# Default: https://aura-nexus-internal.gtnorbeat.workers.dev
# INTERNAL_API_URL=https://aura-nexus-internal.gtnorbeat.workers.dev

# API key for authenticating with the internal Worker (generated by /internal:init).
# INTERNAL_API_KEY=...

# Numeric user ID for saving conversations to the internal Worker.
# Auto-derived from the project directory name if not set.
# INTERNAL_USER_ID=2

# Custom email for /internal:init user creation.
# Auto-derived as cli-<project-dir>@aura-nexus.local if not set.
# INTERNAL_USER_EMAIL=cli-my-project@aura-nexus.local


# ---------------------------------------------------------------------------
# CHAT WORKER — Cloudflare Worker (for proxied pipeline execution)
# ---------------------------------------------------------------------------

# URL of the public chat Worker. When set, the CLI will detect it and offer
# the /worker command to route requests through the Cloudflare pipeline.
# Default: https://aura-nexus.gtnorbeat.workers.dev
# NEXUS_WORKER_URL=https://aura-nexus.gtnorbeat.workers.dev


# ---------------------------------------------------------------------------
# OPTIONAL — Feature flags & tuning
# ---------------------------------------------------------------------------

# Show planner reasoning in the TUI without the --debug flag.
# AURA_SHOW_REASONING=true

# Max chars of planner output before hard-truncation. Default: 12000.
# AURA_MAX_PLAN_CHARS=12000

# Max chars of final executor prompt before hard-truncation. Default: 32000.
# AURA_MAX_PROMPT_CHARS=32000

# Max validation iterations (1 = no retry, 2 = 1 retry). Default: 2.
# AURA_MAX_ITERATIONS=2


# ---------------------------------------------------------------------------
# CLOUDFLARE — For wrangler / worker deployments
# ---------------------------------------------------------------------------

# Cloudflare API token with Workers permissions.
# Needed if you deploy workers via wrangler from this repo.
# Create a token at: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=...
