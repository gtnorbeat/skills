# Cloudflare Pages _headers — cache rules for static assets
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Vite hashes chunk filenames (e.g. index-a1b2c3d4.js), so /assets/*
# is safe to cache for one year. A new deploy changes the hash, which
# counts as a fresh URL — clients and Cloudflare's edge will re-fetch.
#
# Note: _headers does NOT apply to Pages Functions (our /api/* proxy).
# API caching is controlled by Cache Rules in the Cloudflare Dashboard
# and by Cache-Control headers in the Function response itself.

# Service worker must NEVER be cached at the edge — the browser checks
# sw.js byte-for-byte to detect updates. If Cloudflare serves a stale
# copy, the browser never learns about new deploys. no-cache still
# allows conditional revalidation (ETag/Last-Modified) so a 304 response
# keeps the round-trip cheap when the file hasn't changed.
/sw.js
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
