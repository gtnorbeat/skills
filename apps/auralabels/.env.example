# =====================================================================
# AURA -- production env schema (sample values only, do NOT commit)
# =====================================================================
# Operator copy flow:
#   1. cp .env.example .env
#   2. Fill in the 4 production-must-have values below
#   3. Set the same values on Vercel Dashboard
#      (Project -> Settings -> Environment Variables -> Production scope)
#   4. .env is gitignored -- only .env.example ships in the repo as the
#      canonical schema reference.
#
# Cross-reference: knowledge.deploy.md sect AURA Production Env Reference
# for the role + what-breaks-when-unset detail on each var.
# =====================================================================


# ----- 4 production must-haves -----

# JWT_SECRET
#   Signs the 7-day JWT issued by POST /api/login. Without this the
#   server enters quarantine mode and 503s every /api/* except the
#   diagnostic endpoints -- Gate A in the boot-guard verdict fails.
JWT_SECRET=
#   Generate locally (output is a base64url-safe random blob):
#     openssl rand -base64 48 | tr +/ -_ | tr -d =
#   Rotation: does NOT hot-reload; redeploy on value change.

# BOOTSTRAP_ADMIN_USERNAME
#   First-time admin row seed when the users table is empty. Plain
#   string. Idempotent -- once users has any row, subsequent boots are
#   no-ops. Required on a fresh volume alongside BOOTSTRAP_ADMIN_PASSWORD.
BOOTSTRAP_ADMIN_USERNAME=

# BOOTSTRAP_ADMIN_PASSWORD
#   Bcrypt-hashed (cost 10) on first boot -> users.passwordHash column.
#   Plaintext never persisted. Required on a fresh volume alongside
#   BOOTSTRAP_ADMIN_USERNAME. >= 8 chars enforced; >= 12 recommended.
BOOTSTRAP_ADMIN_PASSWORD=

# WEBHOOK_SECRET
#   HMAC-SHA256 over the raw POST body for /api/webhook/* AND over the
#   raw BINARY bytes for /api/admin/import (post-cefb6b8 body-parser
#   fix routes through req.body). When unset, both endpoints revert to
#   the open-by-UUID legacy behaviour -- spoof-able the moment a UUID
#   scrapes from Render logs.
#   Make.com scenarios MUST read the same string as a scenario variable.
WEBHOOK_SECRET=


# ----- Required-by-platform (set on first deploy, but have defaults) -----

# NODE_ENV=production
# PORT=3001


# ----- Public canonical (documentation-only; future custom domain) -----

# PUBLIC_CANONICAL_URL=https://auralabels.app
#   Documentation-only right now. Once DNS lands, this replaces the
#   Vercel auto-generated URLs in the metadata, SEO tags, and /api/_meta.
#   The current canonical host (baked into index.html + JSON-LD @id) is
#   https://aura-iota-two.vercel.app/ — until the custom domain lands,
#   that Vercel hash is the live canonical. After DNS resolves
#   auralabels.app, a single-source-of-truth follow-up commit will:
#     1. Replace the Vercel host with https://auralabels.app/ in
#        index.html (canonical + og:url + og:image + twitter:image +
#        JSON-LD @id Organization + JSON-LD @id SoftwareApplication +
#        3 url / contentUrl siblings — 9 sites total).
#     2. Update HANDOFF.md `<your-vercel-domain>` placeholders (4) to
#        the custom domain.
#     3. Update /api/_meta handler to read PUBLIC_CANONICAL_URL first
#        (fallback chain: env -> VERCEL_PROJECT_PRODUCTION_URL -> VERCEL_URL).
#   Drop this row entirely if PUBLIC_CANONICAL_URL is left at default
#   and the operator decides to keep Vercel's auto URLs in perpetuity.


# ----- Backup schedule (already enabled out of the box) -----

# BACKUP_DIR=/data/backups
# BACKUP_RETENTION=7
# BACKUP_HOUR_UTC=3
# BACKUP_ENABLE_DEV=0


# ----- Volume safety -----

# VOLUME_GUARD_STRICT=0
#   Set to 1 to refuse boot when /data is overlay layer (vs. real Volume).


# ----- AI keypair (both optional; template fallback if both unset) -----

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=


# ----- Build / corepack -----

# COREPACK_INTEGRITY_KEYS=1
#   Disable npm signature-key prompts (see knowledge.deploy.md sect 21).
