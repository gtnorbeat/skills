# =============================================================================
# AURA Labels — Local Development Variables
# =============================================================================
# Copy to .dev.vars and fill in for `wrangler dev`.
# Never commit .dev.vars or real secrets.
# =============================================================================

# JWT signing secret (HS256). Must be set before first deploy.
JWT_SECRET=change-me-to-a-random-64-char-string

# Bootstrap admin credentials (used on first run when users table is empty).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login

# Neon Postgres connection string.
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# LLM calls are routed through the dedicated LLM Worker.
# ANTHROPIC_API_KEY is only needed for direct Claude calls (not routed through LLM worker).
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Webhook HMAC secret for Make.com / external integrations.
# WEBHOOK_SECRET=change-me

# Optional: hCaptcha secret key for registration form verification.
# Get your secret key at https://dashboard.hcaptcha.com/
# Enterprise keys start with "ES_", standard keys start with "0x"
# HCAPTCHA_SECRET_KEY=ES_your-enterprise-key-here
